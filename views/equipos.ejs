<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Equipos</title>
</head>
<body>
  <header>
    <h1>Inventario de equipos</h1>
  </header>
  <main>
    <form action="/equipos" method="get">
      <label>Nombre
        <input name="q" value="<%= filtros.q %>" maxlength="80">
      </label>
      <label>Categoría
        <input name="categoria" value="<%= filtros.categoria %>" maxlength="40"
               placeholder="portatil, tableta, proyector...">
      </label>
      <label>Disponibilidad
        <select name="disponible">
          <option value="" <%= filtros.disponible === '' ? 'selected' : '' %>>Todos</option>
          <option value="si" <%= filtros.disponible === 'si' ? 'selected' : '' %>>Disponibles</option>
          <option value="no" <%= filtros.disponible === 'no' ? 'selected' : '' %>>Prestados</option>
        </select>
      </label>
      <label>Ordenar por
        <select name="orden">
          <option value="codigo" <%= filtros.orden === 'codigo' ? 'selected' : '' %>>Código</option>
          <option value="nombre" <%= filtros.orden === 'nombre' ? 'selected' : '' %>>Nombre</option>
        </select>
      </label>
      <button>Buscar</button>
    </form>

    <% if (equipos.length === 0) { %>
      <p>No hay equipos que cumplan los criterios en esta página.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Nombre</th>
            <th scope="col">Categoría</th>
            <th scope="col">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% for (const equipo of equipos) { %>
            <tr>
              <td><%= equipo.codigo %></td>
              <td><a href="/equipos/<%= equipo.id %>"><%= equipo.nombre %></a></td>
              <td><%= equipo.categoria %></td>
              <td><%= equipo.estado %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>

    <nav aria-label="Paginación">
      <p>Página <%= filtros.pagina %></p>
      <% if (anterior) { %><a href="<%= anterior %>">Anterior</a><% } %>
      <% if (siguiente) { %><a href="<%= siguiente %>">Siguiente</a><% } %>
    </nav>
  </main>
</body>
</html>
